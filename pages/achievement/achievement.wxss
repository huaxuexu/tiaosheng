/* pages/achievement/achievement.wxss —— 成就（对齐原型 pgAchievement）
   公共件（.head/.card/.sec/.grid3/.pbar/... ）在 app.wxss。 */

.ach-page {
  min-height: 100vh;
  background: var(--page);
  padding-bottom: 180rpx;
  box-sizing: border-box;
}

/* ---- 等级卡 ---- */
.level-card {
  margin: 0 28rpx;
  background: var(--brand);
  border-radius: var(--r-lg);
  padding: 32rpx;
  display: flex;
  align-items: center;
  gap: 28rpx;
}
.lv-badge { text-align: center; flex: none; }
.lv-cap { font-size: 21rpx; color: rgba(255, 255, 255, 0.8); }
.lv-num { font-size: 48rpx; font-weight: 600; color: #fff; line-height: 1.15; }
.lv-main { flex: 1; min-width: 0; }
.lv-name { font-size: 27rpx; font-weight: 600; color: #fff; }
.lv-bar { margin-top: 18rpx; background: rgba(255, 255, 255, 0.28); }
.lv-bar .pbar-fill { background: #fff; }
.lv-hint { font-size: 21rpx; color: rgba(255, 255, 255, 0.85); margin-top: 14rpx; }

/* ---- 徽章 ---- */
.badge-grid { padding: 0 28rpx 40rpx; }
.badge {
  background: #F5F6F7;
  border-radius: var(--r-lg);
  padding: 24rpx 12rpx;
  text-align: center;
}
.badge.on { background: var(--card); }
.badge-chip {
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  margin: 0 auto;
  background: var(--brand-bg);
  display: flex;
  align-items: center;
  justify-content: center;
}
.badge-chip.off { background: #E6E8EA; }
.badge-name { font-size: 21rpx; font-weight: 400; margin-top: 16rpx; color: var(--ink3); }
.badge.on .badge-name { font-weight: 600; color: var(--ink); }
.badge-desc { font-size: 19rpx; margin-top: 4rpx; color: var(--ink4); }
.badge.on .badge-desc { color: var(--ink3); }

/* ============ 未建立档案：等级与徽章锁定态（2026-09-16）============
   等级卡由品牌橙整体灰化（橙底上放 Lv.— 会被读成「你已经是会员」）；
   8 个徽章全部按未解锁渲染，复用 .badge-chip.off 的灰底灰字，不留任何进度数值。 */
.level-card.locked { background: #F5F6F7; }
.level-card.locked .lv-cap { color: var(--ink3); }
.level-card.locked .lv-num { color: var(--ink2); }
.level-card.locked .lv-name { color: var(--ink2); }
.level-card.locked .lv-hint { color: var(--ink3); }

.empty-hint {
  margin: 20rpx 28rpx 0;
  padding: 24rpx 28rpx;
  background: var(--brand-bg2);
  border-radius: var(--r-md);
  font-size: 24rpx;
  color: var(--brand);
}
