/* pages/challenge/challenge.wxss —— 训练挑战（对齐原型 pgChallenge）
   公共件（.head/.card/.sec/.btn/.pbar/... ）在 app.wxss。 */

.challenge-page {
  min-height: 100vh;
  background: var(--page);
  padding-bottom: 180rpx;
  box-sizing: border-box;
}

/* 页首右侧：完成度圆牌 */
.pct-badge {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--brand);
}

/* 无记录引导 */
.empty-hint {
  margin: 0 28rpx 20rpx;
  padding: 24rpx 28rpx;
  background: var(--brand-bg2);
  border-radius: var(--r-md);
  font-size: 24rpx;
  color: var(--brand);
}

/* 挑战卡片 */
.ch-list { padding: 0 28rpx; display: flex; flex-direction: column; gap: 18rpx; }
.ch-card { display: flex; gap: 26rpx; align-items: center; padding: 26rpx 30rpx; }
.ch-card.done { background: var(--brand); }
.ch-card-hover { opacity: 0.94; }

.ch-chip {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--brand-bg);
}
.ch-chip.done { background: rgba(255, 255, 255, 0.25); }

.ch-body { flex: 1; min-width: 0; }
.ch-top { display: flex; align-items: center; gap: 16rpx; }
.sec.on-dark { color: #fff; }
.done-tag {
  font-size: 21rpx;
  color: var(--brand);
  background: #fff;
  border-radius: var(--r-pill);
  padding: 4rpx 16rpx;
}

.ch-desc { font-size: 22rpx; margin-top: 10rpx; }
.on-dark-soft { color: rgba(255, 255, 255, 0.85); }

.ch-progress { display: flex; align-items: center; gap: 18rpx; margin-top: 20rpx; }
.ch-pbar { flex: 1; }
.ch-num { font-size: 21rpx; }

/* 去训练 */
.go-train { margin: 28rpx 28rpx 40rpx; }

/* ============ 未建立档案：锁定预览（2026-09-16）============
   保留卡片（名字 / 图标 / 描述），只把「进度」换成锁。
   卡片保持白底可读 —— 这是「一张上锁的地图」，不是坏掉的页面。 */
.pct-badge.locked { background: #F5F6F7; }
.ch-card.locked .sec { color: var(--ink2); }
.ch-chip.locked { background: #E6E8EA; }
.ch-lock { display: flex; align-items: center; gap: 10rpx; margin-top: 20rpx; }
.ch-lock-t { font-size: 21rpx; color: var(--ink3); }
