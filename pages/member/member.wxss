/* pages/member/member.wxss —— 会员权益（对齐原型 pgMember）
   公共件（.sec-row/.lv-pill/.grid2/.pbar/.back-row/... ）在 app.wxss。 */

.member-page {
  min-height: 100vh;
  background: var(--page);
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

/* ---- 等级头 ---- */
.m-hero {
  background: var(--brand);
  padding-left: 32rpx;
  padding-right: 32rpx;
  padding-bottom: 48rpx;
  text-align: center;
}
.back-row { margin-bottom: 12rpx; }
.back-glyph { font-size: 28rpx; color: rgba(255, 255, 255, 0.9); }
.back-text { font-size: 25rpx; color: rgba(255, 255, 255, 0.9); }

.m-total { font-size: 30rpx; color: #fff; margin-top: 26rpx; }
.m-progress { margin-top: 32rpx; }
.m-bar { background: rgba(255, 255, 255, 0.28); }
.m-bar .pbar-fill { background: #fff; }
.m-progress-text { font-size: 21rpx; color: rgba(255, 255, 255, 0.9); margin-top: 18rpx; }

/* ---- 权益网格 ---- */
.b-grid { padding: 0 28rpx 28rpx; }
.b-card {
  background: #F5F6F7;
  border-radius: 28rpx;
  padding: 26rpx 22rpx;
}
.b-card.on { background: var(--card); }
.b-chip {
  width: 60rpx;
  height: 60rpx;
  border-radius: 18rpx;
  background: var(--brand-bg);
  display: flex;
  align-items: center;
  justify-content: center;
}
.b-chip.off { background: #E6E8EA; }
.b-name { font-size: 25rpx; font-weight: 400; margin-top: 20rpx; color: var(--ink3); }
.b-card.on .b-name { font-weight: 600; color: var(--ink); }
.b-desc { font-size: 19rpx; margin-top: 6rpx; color: var(--ink4); line-height: 1.5; }
.b-card.on .b-desc { color: var(--ink3); }
.b-lock {
  display: inline-block;
  margin-top: 12rpx;
  font-size: 19rpx;
  color: var(--ink3);
  background: #E6E8EA;
  border-radius: var(--r-pill);
  padding: 4rpx 14rpx;
}

/* ---- 底部说明 ---- */
.m-tip {
  margin: 0 28rpx;
  font-size: 22rpx;
  text-align: center;
  line-height: 1.7;
  color: var(--ink3);
}
